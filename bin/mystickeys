#!/usr/bin/env python3
"""Launcher for the mystickeys CLI (run from the project or via the installed symlink)."""
import os
import sys

# realpath follows the /usr/local/bin symlink back to the project directory
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from mystickeys.cli import run  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(run())
